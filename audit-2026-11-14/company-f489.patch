e(rb_t(gate->'at'), '') !~ '^\\d{4}-' or (gate->>'at')::timestamptz < now() - interval '15 minutes' then raise exception 'RB_FALLBACK BOM 직접 저장 표시가 오래됨'; end if;\n  if rb_t(gate->'dirty') <> '' then raise exception 'RB_FALLBACK 시트가 Supabase 보다 앞섬'; end if;\n  select rc.v into conf from rb_conf rc where rc.k = 'bomConf';\n  head := conf->'head';\n  if head is null or rb_bom_hidx(head, 'id') is null or rb_bom_hidx(head, 'cost') is null then raise exception 'RB_FALLBACK BOM 머리글 모름'; end if;\n  -- ── 옮기지 않은 경우 → 서버 길 ──\n  if jsonb_typeof(meta->'follow') = 'object' and rb_num(meta->'follow'->'statusRow') >= 2 then raise exception 'RB_FALLBACK 발주 건 맞추기(follow)'; end if;\n\n  perform pg_advisory_xact_lock(hashtext('rb_bom'));\n  -- 서버(GAS 가상 저장)가 읽고 올리는 사이면 그 저장이 끝날 때까지 서버 길로(서버 길은 스크립트 잠금에서 차례를 기다림) — m030 rb_bom_lease\n  if exists (select 1 from rb_conf rc where rc.k = 'bomLease' and coalesce(rb_t(rc.v->'until'), '') ~ '^\\d{4}-' and (rc.v->>'until')::timestamptz > now()) then raise exception 'RB_FALLBACK BOM 서버 저장 중'; end if;\n  -- ── 같은 요청 두 번(응답만 잃은 경우 — 잠금 안에서 봐야 동시에 두 번 온 것도 막음) ──\n  if op <> '' then\n    select rv into hit from rb_recent where rk = 'op:bom:' || op and rat > now() - interval '30 minutes';\n    if hit is not null then return hit::jsonb || '{\"duplicate\":true}'::jsonb; end if;\n  end if;\n\n  -- ── 그 품목 줄(Supabase 가 원본) ──\n  select coalesce(jsonb_agg(to_jsonb(b) order by b.sheet_row, b.id), '[]'::jsonb) into prow from bom_rows b where upper(b.product) = P;\n  if jsonb_array_length(prow) = 0 then\n    if jsonb_typeof(meta->'newProduct') is distinct from 'object' then raise exception 'BOM 탭에 % 줄이 없습니다.', P; end if;\n    isNew := true;                                   -- m048: 신제품 BOM\n  elsif jsonb_typeof(meta->'newProduct') = 'object' then\n    -- 앞에서 누른 저장이 이미 들어감(bomNewSame_) — 아무것도 쓰지 않고 저장된 BOM 을 돌려준다(already)\n    if rb_bom_newsame(prow, chg) then\n      return jsonb_build_object('ok', true, 'sb', 1, 'code', P, 'already', 1, 'made', '[]'::jsonb, 'saved', 0, 'logTag', '', 'splitMap', '{}'::jsonb, 'follow', null,\n        'rows', (select coalesce(jsonb_agg(to_jsonb(b) - 'synced_at' order by b.sheet_row, b.id), '[]'::jsonb) from bom_rows b where upper(b.product) = P),\n        'log', (select coalesce(jsonb_agg(to_jsonb(l) - 'synced_at' order by l.sheet_row desc), '[]'::jsonb) from (select * from bom_log where upper(product) = P order by sheet_row desc limit 50) l));\n    end if;\n    raise exception '품목코드 % 는 그사이 BOM이 생겼습니다(다른 사람이 같은 코드를 먼저 저장). [만들기]를 다시 눌러 새 코드를 받아 주세요.', P;\n  end if;\n  for x in select y from jsonb_array_elements(prow) y loop\n    if rb_t(x->'id') = '' or rb_t(x->'id') ~ '^R\\d' then raise exception 'RB_FALLBACK 줄ID 없는 줄(% 행)', x->>'sheet_row'; end if;\n    if bysr ? (x->>'sheet_row') then raise exception 'RB_FALLBACK 행 번호 겹침 %', x->>'sheet_row'; end if;\n    O := O || jsonb_build_object(x->>'id', x);\n    bysr := bysr || jsonb_build_object(x->>'sheet_row', x->>'id');\n    lastRow := (x->>'sheet_row')::int; tmplId := x->>'id';\n    if upper(rb_t(x->'code')) = P or rb_t(x->'type') = '제품' then prodName := coalesce(nullif(prodName, ''), rb_t(x->'name')); end if;\n  end loop;\n  brand := rb_t(prow->0->'brand');\n  -- 수식(sheet_rows '_bomfml:줄ID'). 모르는 줄이 있거나 범위 수식(맨 아래 붙이기가 안 되는 품목 — bomAppendSafe_)이면 서버 길\n  for x in select y from jsonb_array_elements(prow) y loop\n    select cells into fm from sheet_rows where tab = '_bomfml:' || (x->>'id') and \"row\" = 0;\n    if fm is null then raise exception 'RB_FALLBACK 수식 모름(% 행)', x->>'sheet_row'; end if;\n    for fk in select jsonb_object_keys(fm) loop\n      if rb_t(fm->fk) = '' then fm := fm - fk; continue; end if;\n      if rb_t(fm->fk) ~ ':' then raise exception 'RB_FALLBACK 범위 수식이 있는 품목(% 행)', x->>'sheet_row'; end if;\n    end loop;\n    OF := OF || jsonb_build_object(x->>'id', fm);\n  end loop;\n\n  if isNew then\n    if exists (select 1 from bom_rows b where upper(b.code) = P) then raise exception '품목코드 % 는 이미 다른 품목 BOM에 자재로 쓰이고 있습니다. 코드를 다시 확인해 주세요.', P; end if;\n    if exists (select 1 from jsonb_array_elements(chg) y where y->>'kind' is distinct from 'add') then raise exception '신제품 BOM은 자재 추가로만 만들 수 있습니다.'; end if;\n    brand := rb_t(meta->'newProduct'->'brand'); prodName := rb_t(meta->'newProduct'->'name');\n    if jsonb_typeof(meta->'newProduct'->'extra') = 'array' then\n      select coalesce(array_agg(t order by nn), '{}') into extra from (select upper(rb_t(z)) as t, nn from jsonb_array_elements(meta->'newProduct'->'extra') with ordinality q(z, nn)) w\n        where t ~ '^[A-Z]{1,2}\\d{4}[A-Z]{2}\\d+$' and t <> P;\n    end if;\n    foreach ec in array extra loop\n      if exists (select 1 from bom_rows b where upper(b.product) = ec or upper(b.code) = ec) then raise exception '국가별 코드 % 는 그사이 BOM에 쓰였습니다. [만들기]를 다시 눌러 주세요.', ec; end if;\n    end loop;\n    -- 새 줄은 BOM 탭 맨 아래 줄을 본뜬다(값 · 수식)\n    select to_jsonb(b) into tmplRec from bom_rows b order by b.sheet_row desc, b.id desc limit 1;\n    if tmplRec is null or rb_t(tmplRec->'id') = '' or rb_t(tmplRec->'id') ~ '^R\\d' then raise exception 'RB_FALLBACK 맨 아래 줄 모름'; end if;\n    select cells into tmplF from sheet_rows where tab = '_bomfml:' || (tmplRec->>'id') and \"row\" = 0;\n    if tmplF is null then raise exception 'RB_FALLBACK 수식 모름(맨 아래 줄)'; end if;\n    tmplF := (select coalesce(jsonb_object_agg(key, value), '{}'::jsonb) from jsonb_each(tmplF) where rb_t(value) <> '');\n    tmplId := tmplRec->>'id'; lastRow := (tmplRec->>'sheet_row')::int;\n  end if;\n  -- ── 줄 다시 찾기(bomReRow_) · 끝 차수 확인 ──\n  for i in 0 .. jsonb_array_length(chg) - 1 loop\n    c := chg->i;\n    if c->>'kind' = 'add' then continue; end if;\n    rr := case when rb_t(c->'row') ~ '^\\d+$' then rb_t(c->'row')::int else null end;\n    rid := bysr->>(rr::text);\n    same_ids := '{}'; byid := '{}';\n    for x in select y from jsonb_array_elements(prow) y loop\n      if upper(rb_t(x->'code')) = upper(rb_t(c->'code')) and rb_t(x->'start_round') = rb_t(c->'start') and (not (c ? 'end'