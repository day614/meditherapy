 SB_MIGRATIONS.push({ id: 'm073_bom_save_nonew', sql: "create or replace function rb_bom_save_do(e text, a jsonb) returns jsonb language plpgsql security definer set search_path = public as $f$\ndeclare\n  P text := upper(btrim(coalesce(a->>'product', '')));\n  N int; nraw text := rb_t(a->'round');\n  meta jsonb := coalesce(a->'meta', '{}'::jsonb);\n  op text := left(rb_t(a->'op'), 60); hit text;\n  EDIT constant text[] := array['name','vendor','buy','spec','moq','qty','unit','cur','fx','proc','ship'];\n  LABEL constant jsonb := '{\"name\":\"품목명\",\"vendor\":\"업체\",\"buy\":\"매입정보\",\"spec\":\"사양\",\"moq\":\"MOQ\",\"qty\":\"소요량\",\"unit\":\"단가\",\"cur\":\"통화\",\"fx\":\"환율\",\"proc\":\"임가공\",\"ship\":\"배송비\"}';\n  gate jsonb; conf jsonb; head jsonb;\n  chg jsonb := '[]'::jsonb; c jsonb; x jsonb; k text; i int;\n  prow jsonb; O jsonb := '{}'::jsonb; OF jsonb := '{}'::jsonb; W jsonb := '{}'::jsonb; bysr jsonb := '{}'::jsonb;\n  lastRow int; tmplId text; maxSr int; maxB int; prodName text := ''; brand text := '';\n  same_ids text[]; byid text[]; rid text; rr int;\n  ckOff jsonb := '{}'::jsonb; ckC jsonb := '[]'::jsonb; eX int; rgS int; rgE int;\n  adds jsonb; edits jsonb; ordered jsonb;\n  U jsonb := null; seenW jsonb := '{}'::jsonb; unmark jsonb := '[]'::jsonb; renumMap jsonb := '{}'::jsonb;\n  batch text := substr(md5(random()::text || clock_timestamp()::text), 1, 8);\n  stamp text := to_char(now() at time zone 'Asia/Seoul', 'YY/MM/DD');\n  nowiso text := to_char(now() at time zone 'UTC', 'YYYY-MM-DD\"T\"HH24:MI:SS.MS\"Z\"');\n  orderRef text := '';\n  pn int := 0; pid text; why text; logs jsonb := '[]'::jsonb; hist jsonb := '[]'::jsonb; regs jsonb := '[]'::jsonb; made jsonb := '[]'::jsonb;\n  splitMap jsonb := '{}'::jsonb; ins jsonb := '{}'::jsonb; upd jsonb := '{}'::jsonb; touched text[] := '{}';\n  setK jsonb; anySet boolean; s0 int; e0 int; oldCode text; newCode text; renumber boolean; rnKey text; base text; wantR text; ver numeric;\n  parts text[]; bef text[]; aft