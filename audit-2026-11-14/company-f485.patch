IT) kk)));\n      if extend then ch_ := rb_bom_w(ch_, 'end', to_jsonb(''::text), head); end if;\n    else\n      undo := jsonb_build_object('oldRef', jsonb_build_object('code', oldCode, 'start', rb_t(x->'start_round'), 'id', rb_t(x->'id'), 'endNow', (N - 1) || '차',\n        'prevEnd', rb_bom_cell(x, 'end'), 'prevF', rb_bom_cell(x, 'costKey'), 'prevCh', rb_bom_cell(x, 'change')));\n      ch_ := rb_bom_w(ch_, 'end', to_jsonb((N - 1) || '차'), head);\n      if not remove then\n        oc := rb_t(x->'change');\n        ch_ := rb_bom_w(ch_, 'change', to_jsonb(case when oc <> '' then oc || ' / ' else '' end || N || '차부터 ' || case when renumber then newCode || ' 로 바뀜' else '새 줄로 바뀜' end\n          || case when s0 = N then ' (이 줄은 쓰지 않음)' else '' end), head);\n        W := W || jsonb_build_object(rid, ch_); touched := touched || rid;\n        -- 원래 줄(방금 고친 것)을 본떠 맨 아래에 새 줄\n        maxSr := maxSr + 1; maxB := maxB + 1; newId := 'B' || lpad(maxB::text, 6, '0');\n        nv := (ch_->'r') || jsonb_build_object('id', newId, 'sheet_row', maxSr);\n        ch_ := jsonb_build_object('r', nv, 'f', coalesce(ch_->'f', '{}'::jsonb));\n        ch_ := rb_bom_w(ch_, 'start', to_jsonb(N || '차'), head);\n        ch_ := rb_bom_w(ch_, 'end', to_jsonb(case when not extend and e0 is not null and e0 <> 0 and e0 >= N then rb_t(x->'end_round') else '' end), head);\n        ch_ := rb_bom_w(ch_, 'firstAt', to_jsonb(''::text), head);\n        ch_ := rb_bom_w(ch_, 'oldCode', to_jsonb(''::text), head);\n        ch_ := rb_bom_w(ch_, 'id', to_jsonb(newId), head);\n        undo := undo || jsonb_build_object('newRef', jsonb_build_object('code', newCode, 'start', N || '차', 'id', newId));\n        splitMap := splitMap || jsonb_build_object(rb_t(x->'id'), newId);\n        ins := ins || jsonb_build_object(newId, rid);\n        target := newId; tgtRow := maxSr;\n      end if;\n    end if;\n    -- 바뀐 뒤 줄(target)에 칸 · 코드 · 원가 체크 · 변동사항\n    if renumber then ch_ := rb_bom_w(ch_, 'code', to_jsonb(newCode), head); undo := undo || jsonb_build_object('reg', newCode); end if;\n    foreach k in array EDIT loop\n      if setK ? k then\n        ch_ := rb_bom_w(ch_, k, case when k = 'cur' then to_jsonb(rb_bom_cur(rb_t(c->k))) when rb_bom_isnum(k) then to_jsonb(rb_num(c->k)) else to_jsonb(rb_t(c->k)) end, head);\n      end if;\n    end loop;\n    if not remove and jsonb_typeof(c->'ck') = 'boolean' then ch_ := rb_bom_w(ch_, 'costKey', to_jsonb(case when c->'ck' = 'true'::jsonb then P else '' end), head); end if;\n    ch_ := rb_bom_w(ch_, 'change', to_jsonb(N || '차 ' || array_to_string(parts, ' · ') || case when why <> '' then ' (' || why || ')' else '' end || ' · ' || stamp), head);\n    if not remove and (setK ? 'unit' or setK ? 'qty' or setK ? 'proc' or setK ? 'ship' or setK ? 'fx') then ch_ := rb_bom_fixcost(ch_, x, head); end if;\n    W := W || jsonb_build_object(target, ch_);\n    if not (target = any(touched)) then touched := touched || target; end if;\n    logs := logs || jsonb_build_array(jsonb_build_object('id', pid, 'kind', kind, 'type', rb_t(x->'type'), 'codeA', oldCode, 'codeB', case when remove then '' else newCode end,\n      'before', array_to_string(bef, ' · '), 'after', array_to_string(aft, ' · '), 'why', why, 'undo', undo));\n    hist := hist || jsonb_build_array(jsonb_build_object('kind', 'BOM', 'item', P || ' ' || N || '차 ' || rb_t(x->'type') || ' ' || kind, 'before', array_to_string(bef, ' · '),\n      'after', case when renumber then newCode || ' · ' else '' end || array_to_string(aft, ' · '), 'reason', why, 'where', 'BOM 시트 ' || tgtRow || '행'));\n  end loop;\n  if pn = 0 then raise exception '바뀐 값이 없습니다.'; end if;\n\n  -- ── 고친 줄 · 새 줄의 남은 수식 다시 계산(흉내 시트가 고친 줄 수식을 다시 계산하듯 — 같은 줄 사칙만) ──\n  foreach rid in array touched loop\n    ch_ := W->rid;\n    W := W || jsonb_build_object(rid, jsonb_set(ch_, '{r}', rb_bom_evalrow(ch_->'r', ch_->'f', head)));\n  end loop;\n  -- ── 신제품 국가별 코드: 넣은 줄을 그 코드로 한 벌씩 더(제품코드 · 원가반영 · 제품 줄 자재코드 · 변동사항 · 새 줄ID) ──\n  if isNew then\n    maxSr := lastRow + coalesce(array_length(addedIds, 1), 0);\n    select coalesce(array_agg(t order by (W->t->'r'->>'sheet_row')::int), '{}') into addedIds from unnest(addedIds) t;      -- 시트 순서\n  end if;\n  -- ── 핸들링피(hfApplyRows_ — 넣은 줄만 · 제조사 설정이 있으면 배송비/기타 칸에 수식) ──\n  if coalesce(array_length(addedIds, 1), 0) > 0 then\n    if conf->'hf' is null then raise exception 'RB_FALLBACK 핸들링피 설정 모름'; end if;\n    select coalesce(jsonb_agg(r order by (r->>'sheet_row')::int), '[]'::jsonb) into tmpRows\n      from (select coalesce(W->key->'r', value) as r from jsonb_each(O) union all select W->t->'r' from unnest(addedIds) t) z;\n    wv := rb_bom_hfmaker(tmpRows, P);\n    hfv := conf->'hf'->rb_bom_hfkey(wv);\n    if rb_bom_hfkey(wv) <> '' and hfv is not null and rb_num(hfv->'pct') > 0 then\n      hfN := 0; hfSkip := '[]'::jsonb;\n      foreach aid in array addedIds loop\n        tmp := rb_bom_hfapply(W->aid, P, hfv, head);\n        if tmp->>'st' = 'n' then W := W || jsonb_build_object(aid, tmp->'w'); hfN := hfN + 1;\n        elsif tmp->>'st' = 'skip' then hfSkip := hfSkip || to_jsonb((W->aid->'r'->>'sheet_row')::int); end if;\n      end loop;\n      hfRes := jsonb_build_object('vendor', wv, 'pct', trim_scale(round(rb_num(hfv->'pct') * 1000) / 1000), 'mode', rb_bom_hfmode(hfv), 'n', hfN, 'skipped', hfSkip);\n    end if;\n  end if;\n  if isNew and coalesce(array_length(extra, 1), 0) > 0 and coalesce(array_length(addedIds, 1), 0) > 0 then\n    foreach ec in array extra loop\n      refs := '[]'::jsonb;\n      foreach aid in array addedIds loop\n        ch_ := W->aid;\n        maxSr := maxSr + 1; maxB := maxB + 1; newId := 'B' || lpad(maxB::text, 6, '0');\n        ch_ := jsonb_set(ch_, '{r}', (ch_->'r') || jsonb_build_object('id', newId, 'sheet_row', maxSr));\n        ch_ := rb_bom_w(ch_, 'product', to_jsonb(ec), head);\n        if rb_t(ch_->'r'->rb_bom_c('costKey')) <> '' then ch_ := rb_bom_w(ch_, 'costKey', to_jsonb(ec), head); end if;\n        cc0 := upper(rb_t(ch_->'r'->'code'));\n        if cc0 = P then ch_ := rb_bom_w(ch_, 'code', to_jsonb(ec), head); cc0 := ec; end if;\n        ch_ := rb_bom_w(ch_, 'change', to_jsonb(N || '차 신제품 ' || ec || ' (' || P || ' 와 같은 구성) · ' || stamp), head);\n        ch_ := rb_bom_w(ch_, 'id', to_jsonb(newId), head);\n        ch_ := jsonb_set(ch_, '{f}', (W->aid->'f'));\n        W := W || jsonb_build_object(newId, ch_); ins := ins || jsonb_build_object(newId, aid); touched := touched || newId;\n        refs := refs || jsonb_build_array(jsonb_build_object('code', cc0, 'start', N || '차'));\n      end loop;\n      regs := regs || jsonb_build_array(jsonb_build_object('brand', brand, 'kind', '제품', 'num', substr(regexp_replace(ec, '^[A-Z]X?', ''), 1, 4), 'prodName', prodName, 'type', '', 'tcode', '',\n        'ver', coalesce(substring(ec from '(\\d+)$')::numeric, 1), 'code', ec, 'name', prodName));\n      made := made || to_jsonb(ec);\n      extraLogs := extraLogs || jsonb_build_array(jsonb_build_array(jsonb_build_object('d', nowiso), e, ec, prodName, N || '차', '신제품 BOM', '제품', '', ec, '',\n        P || ' 와 같은 구성 ' || array_length(addedIds, 1) || '줄', '국가별 코드 함께 생성', '', '유효', batch || '-x' || ec, jsonb_build_object('newRefs', refs, 'regs', jsonb_build_array(ec))::text));\n    end loop;\n  end if;\n  if isNew then\n    newps := jsonb_build_array(jsonb_build_object('product', P, 'name', prodName, 'brand', brand, 'src', '실행판 신제품 BOM ' || P));\n    foreach ec in array extra loop newps := newps || jsonb_build_array(jsonb_build_object('product', ec, 'name', prodName, 'brand', brand, 'src', '실행판 신제품 BOM ' || P)); end loop;\n    pendReg := to_jsonb(array[P] || extra);\n  end if;\n  codesRep := to_jsonb(array[P] || extra);\n\n  -- ── Supabase 에 쓰기(줄 · 수식) + 시트 맞추기 일(bomRepPut_ 모양: ins = {새 줄ID: 본뜬 줄ID} · upd = {줄ID: {칸: v|f}}) ──\n  foreach rid in array touched loop\n    ch_ := W->rid;\n    if ins ? rid then\n      delete from bom_rows where id = rid;\n      insert into bom_rows select * from jsonb_populate_record(null::bom