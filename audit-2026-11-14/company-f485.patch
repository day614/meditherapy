     ch_ := rb_bom_w(ch_, k, case when k = 'cur' then to_jsonb(rb_bom_cur(rb_t(c->k))) when rb_bom_isnum(k) then case when rb_t(c->k) = '' then to_jsonb(''::text) else to_jsonb(rb_num(c->k)) end else to_jsonb(rb_t(c->k)) end, head);\n      end loop;\n      if rb_t(c->'name') = '' then ch_ := rb_bom_w(ch_, 'name', to_jsonb(case when isProd then prodName else prodName || ' ' || rb_t(c->'type') end), head); end if;\n      if rb_num(c->'qty') = 0 then ch_ := rb_bom_w(ch_, 'qty', to_jsonb(1), head); end if;\n      cu1 := coalesce(nullif(rb_bom_cur(rb_t(c->'cur')), ''), '원화');\n      if cu1 = '원화' then fxv := 1;\n      elsif rb_num(c->'fx') <> 0 then fxv := rb_num(c->'fx');\n      elsif rb_num(conf->'fx'->(case cu1 when '달러' then 'USD' else 'CNY' end)) <> 0 then fxv := rb_num(conf->'fx'->(case cu1 when '달러' then 'USD' else 'CNY' end));\n      else raise exception 'RB_FALLBACK 설정 환율 모름'; end if;\n      ch_ := rb_bom_w(ch_, 'cur', to_jsonb(cu1), head);\n      ch_ := rb_bom_w(ch_, 'fx', to_jsonb(fxv), head);\n      ch_ := rb_bom_w(ch_, 'costKey', to_jsonb(case when c->'ck' = 'false'::jsonb then '' else P end), head);\n      ch_ := rb_bom_w(ch_, 'change', to_jsonb(N || '차 ' || case when isNew then '신제품 ' else '자재 추가 ' end || ncode || case when why <> '' then ' (' || why || ')' else '' end || ' · ' || stamp), head);\n      -- bomFixCost_(새 줄): 소요원가가 이 줄 단가를 보는 수식이면 그대로(아래에서 계산), 아니면 값 = calc\n      ch_ := rb_bom_fixcost(ch_, null, head);\n      W := W || jsonb_build_object(newId, ch_);\n      ins := ins || jsonb_build_object(newId, tmplId); touched := touched || newId;\n      addedIds := addedIds || newId;\n      if isComp or rb_bom_truthy(c->'reuse') then null;          -- 가져온 기존 코드 · 세트 구성 완제품은 새 코드 아님\n      elsif isProd then\n        regs := regs || jsonb_build_array(jsonb_build_object('brand', brand, 'kind', case when P ~ '^[A-Z]X' then '반제품' else '제품' end, 'num', substr(regexp_replace(P, '^[A-Z]X?', ''), 1, 4), 'prodName', prodName, 'type', '', 'tcode', '',\n          'v