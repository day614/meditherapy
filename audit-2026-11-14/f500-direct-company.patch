+  if (p.kind === 'redraft') return pdDirectPost_(Object.assign({}, p, { kind: 'poCancel' }));      // 품의 취소와 같은 뒷정리(rb.docq · 진행 기록 상신일/승인일)
+  if (p.kind === 'submit') return poSubmitPost_(p);
+  throw new Error('모르는 뒷정리 ' + p.kind);
+}
+
+/** 상신 완료 뒷정리 — 품의번호 대기열(rb.docq) · 이력 · 캐시 · AP. 진행 기록(상신일 · 체크)과 발주 DB 칸은 SQL 이 이미 바꿨다 */
+function poSubmitPost_(p) {
+  try { pdxDrainIn_(); } catch (eX) { /* 1분 작업이 */ }
+  if (typeof pgxDrainIn_ === 'function') { try { pgxDrainIn_(); } catch (eG) { /* 1분 작업이 */ } }
+  var out = pdDirectPost_({ audits: p.audits || [], ap: true });      // 이력(품의번호(일괄) · 진행상태 · 결재문서번호) · 캐시 · AP
+  if (p.docq && p.docq.length) {      // apiBulkDoc0_ 와 같게: 품의번호 대기열(그 건 ID 로 — 같은 품의번호의 다른 줄까지 상신되지 않게) → 상신 항목 체크 + 상신일
+    var lock = pdLock_();
+    waitLock_(lock);
+    try {
+      var q = docQueueRead_(), today0 = ymd_(new Date(RB_J_AT || Date.now()));
+      p.docq.forEach(function (w) { var key = RB_ID_RE.test(str_(w.id)) ? 'id:' + w.id : norm_(p.no); if (!q[key]) q[key] = today0; });
