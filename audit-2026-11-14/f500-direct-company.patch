+  if (ph && ph.head) {
+    var C = { hr: ph.hr || 1, head: ph.head, idx: headerIndex_(ph.head) }, S = statusFieldCols_(C);
+    S.arr = colIdx_(C.idx, ['제품입고일']); S.hasParts = dbHasParts_(C, S.inQty); S.partial = RB.PARTIAL_MAX;
