+/** 처음 한 번: 스크립트 속성(rb:popend)의 상신 대기를 Supabase 로(잠금 안 · 이미 있으면 그대로) */
+function poPendImport_() {
+  var P = PropertiesService.getScriptProperties();
+  if (P.getProperty('rb.poPendSb') || !sbKey_() || !sbMigDone_('m097_po_pend')) return;
+  var lock = null;
