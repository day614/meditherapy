+  finally { if (lock) lock.releaseLock(); }
+}
+
+/** pj '_poPost' — 직접 저장 뒷정리. RB_ME_AS = 누른 사람 · RB_J_AT = 누른 때 */
+function poDirectPost_(p) {
+  p = p || {};
+  if (p.kind === 'create') {
+    try { pdxDrainIn_(); } catch (eX) { /* 1분 작업이 다시 */ }
+    pdDirectPost_({ audits: p.audits || [], ap: true });      // 이력 '실행판 신규 등록' · 캐시 · 변경 번호 · AP
+    if (p.cur && p.id) {      // 단가 통화(기본값과 다를 때만) — 예전과 같이 진행 기록 checks._cur
