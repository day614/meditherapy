+ *  ① 발주 DB 새 줄 rb_tab_job 'pdx' {add:[{id,row,w}]} — pdxDrainIn_(PdDirect.js)가 tvRepApply_ 새 줄(addAt) 규칙으로
+ *  ② 지급 줄 'ln' — lnDbDrainIn_(예전 직접 저장과 같은 모양 · post 가 발주 행 맞추기 · AP)
+ *  ③ 품목 DB 새 줄 'it' {add} — itemJobDrainIn_(IssueDb.js) 가 appendItems_ 로(슬랙 신규 코드 알림 그대로)
+ *  ④ 'pj' fn '_poPost' — poDirectPost_ : 이력(누른 사람 · 누른 때) · 통화 기록(진행 기록 _cur) · 업체 설정(list.vendor) · 캐시 · AP — 할 일 차례 그대로
+ * 켜짐(rb_conf 'poConf' · on='1' · parts)은 poConfPublish_ 가 1분 작업에서 올린다. 끄개 rb.poDirect=0.
+ * ============================================================
+ */
+var RB_PO_MIG = 'm095_po_direct';
+
+function poDirectMig_() { return typeof sbMigDone_ === 'function' && sbMigDone_(RB_PO_MIG); }
+
+/** 켜짐 · 열 위치 · 목록 — 발주 DB 직접 저장(pdConf) 조건 위에 지급 줄 · 품목 DB 직접 저장 조건 */
+function poConfBuild_(why) {
+  var P = PropertiesService.getScriptProperties();
+  var pd = typeof pdConfBuild_ === 'function' ? pdConfBuild_() : { on: '0', why: 'PdDirect 없음' };
+  var off = why || '';
+  if (!off && !poDirectMig_()) off = 'SQL ' + RB_PO_MIG + ' 전';
+  if (!off && str_(P.getProperty('rb.poDirect')) === '0') off = '끔(rb.poDirect=0)';
+  if (!off && pd.on !== '1') off = '발주 DB 직접 저장 꺼짐(' + str_(pd.why) + ')';
+  var c = { on: off ? '0' : '1', why: off, at: new Date().toISOString(), build: RB_BUILD, parts: {}, why_: {} };
+  var part = function (k, ok, w) { c.parts[k] = ok ? '1' : '0'; if (!ok) c.why_[k] = w; };
+  var lnOk = false, lnW = '';
+  try { lnOk = typeof lnSaveOn_ === 'function' && lnSaveOn_() && !P.getProperty('rb.lndirty'); if (!lnOk) lnW = '지급 줄 직접 저장 꺼짐 · 시트 앞섬'; } catch (eL) { lnW = String(eL.message).slice(0, 80); }
+  var itOk = typeof itemDbOn_ === 'function' && itemDbOn_() && !!str_(P.getProperty('rb.itemSync'));
+  part('it', itOk, '품목 DB 직접 저장 꺼짐(rb.itemDb · 사본 맞추기 전)');
+  part('ln', lnOk, lnW);
+  part('co', lnOk && itOk, '지급 줄 · 품목 DB 직접 저장 조건');
+  part('vd', true, '');
+  try { poPendImport_(); } catch (eI) { /* 다음 1분 */ }
+  part('pp', sbMigDone_('m097_po_pend') && poPendSbOn_(), 'SQL m097 · 상신 대기 옮기기 전');
