 // f493: 진행 기록(체크 · 메모 · 변경 여부 · 날짜) Supabase 직접(rb_pg_save) — PgDirect.js
 SB_MIGRATIONS.push({ id: 'm083_pg_direct', sql: "-- m083_pg_direct — 진행 기록(체크 · 메모 · 변경 여부 · 날짜) 저장을 Supabase 함수로 바로(할 일 대기열 · 진행 장부 아님)\n-- 규칙 = Code.js apiSetChecks · apiSetCheck · apiSetNote · apiSetChange · apiSetDate0_ + Journal.js journalSave_ / applyOp_ / drainJournal_(상태 올리기 · 되돌리기).\n-- 진행 기록 사본 = sheet_rows(tab '_실행판_진행' | '_실행판_샘플진행') — 건ID(1칸) 마지막 줄(readProgress_ 와 같게).\n-- 단계 정의 · 날짜 칸(dateSlots_) · BOM 확인 막기 · 켜짐은 서버가 올린 rb_conf 'pgConf'(pgConfPublish_ → rb_pg_conf_put, 같은 잠금).\n-- 잠금 = rb_tab_commit('pg' | 'sp') 와 같은 advisory lock(hashtext('rb_tab_pg' | 'rb_tab_sp')) — 서버 길 끝맺기(tvVirtualCommit_ pg/sp)도 이 잠금 + p_chk(JS 패치).\n--        날짜로 진행상태를 올리고/내리면 그다음 발주 DB 잠금(rb_tab_pd · m081) — 순서는 늘 pg/sp → pd(거꾸로 잡는 곳 없음).\n-- 뒤처리: rb_tab_job tab='pgx' {mode,id,row}(서버가 그 건 줄의 '지금 사본 값'을 시트에) · tab='pj' fn '_pgPost'(이력 = 실제 applyOp_ 를 before 에 다시 돌려서 · 캐시 · 결과 대조)\n--        상태가 바뀌면 m081 과 같은 'pdx' + '_pdPost'(kind state).\n-- RB_FALLBACK(아무것도 안 바뀜 → 화면은 예전 할 일 길 rb_pj_add): 꺼짐 · 머리글 다름 · 앞선 저장(그 건의 pj 할 일 · 진행 장부 j1: → rb_conf 'pgJ') ·\n--   샘플 옛 건ID(p:코드) · 순서가 중요한 체크 묶음인데 순서 없음 · JSON 칸을 못 읽음 · 흔치 않은 인자 모양 · 상태 올리기인데 발주 DB 직접 저장 꺼짐/앞선 저장/옛 열쇠.\n\n-- ---------- 작은 도우미(JS 와 같은 참/거짓 · 다듬기) ----------\ncreate or replace function rb_pg_tru(v jsonb) returns boolean language sql immutable as $f$\n  select case when v is null then false\n              when jsonb_typeof(v) = 'null' then false\n              when jsonb_typeof(v) = 'boolean' then (v #>> '{}')::boolean\n              when jsonb_typeof(v) = 'number' then (v #>> '{}')::numeric <> 0\n              when jsonb_typeof(v) = 'string' then (v #>> '{}') <> ''\n              else true end $f$;\n\n-- JS String.prototype.trim\ncreate or replace function rb_pg_trim(t text) returns text language sql immutable as $f$\n  select regexp_replace(coalesce(t, ''), '^[\\s\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000\ufeff]+|[\\s\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000\ufeff]+$', '', 'g') $f$;\n\n-- JS String(v) — 글자 · 숫자(정수) · 참거짓만. 그 밖(객체 · 소수 등 표기가 다를 수 있는 것)은 null(부르는 쪽이 RB_FALLBACK)\ncreate or replace function rb_pg_str(v jsonb) returns text language sql immutable as $f$\n  select case when v is null or jsonb_typeof(v) = 'null' then 'null'\n              when jsonb_typeof(v) = 'string' then v #>> '{}'\n              when jsonb_typeof(v) = 'boolean' then v #>> '{}'\n              when jsonb_typeof(v) = 'number' and (v #>> '{}') ~ '^-?(0|[1-9][0-9]{0,14})$' then v #>> '{}'\n              else null end $f$;\n\n-- 진행 기록 칸(JSON 글자) 읽기 — progRec_: JSON.parse(r || '{}') · 못 읽으면 {}. PG 와 JS 가 다르게 읽을 수 있는 칸(못 읽음 · 객체 아님)은 RB_FALLBACK\ncreate or replace function rb_pg_json(c jsonb) returns jsonb language plpgsql immutable as $f$\ndeclare t text; j jsonb;\nbegin\n  if c is null or jsonb_typeof(c) = 'null' then return '{}'::jsonb; end if;\n  if jsonb_typeof(c) <> 'string' then raise exception 'RB_FALLBACK 진행 기록 칸 모양(%)', jsonb_typeof(c); end if;\n  t := c #>> '{}';\n  if t = '' then return '{}'::jsonb; end if;\n  begin j := t::jsonb; exception when others then raise exception 'RB_FALLBACK 진행 기록 칸 JSON 읽기'; end;\n  if jsonb_typeof(j) = 'object' then return j; end if;\n  if not rb_pg_tru(j) then return '{}'::jsonb; end if;      -- null · false · 0 · \"\" → {}\n  raise exception 'RB_FALLBACK 진행 기록 칸이 객체가 아님';\nend $f$;\n\n-- itemKey_(st, i) — 항목 k(없거나 '' 이면 순번)\ncreate or replace function rb_pg_ikey(st jsonb, i int) returns text language sql immutable as $f$\n  select coalesce(st->>'id', '') || '_' || case\n    when jsonb_typeof(st->'items'->i) = 'object' and (st->'items'->i) ? 'k' and (st->'items'->i->'k') <> '\"\"'::jsonb\n      then coalesce(rb_pg_str(st->'items'->i->'k'), (st->'items'->i->'k')::text)\n    else i::text end $f$;\n\n-- stepKeyAlias_ — 발주 단계 새 순서(rb.steps.v2) 뒤 옛 열쇠 → 새 열쇠 · 없앤 항목은 ''\ncreate or replace function rb_pg_alias(v2 boolean, k text) returns text language plpgsql immutable as $f$\ndeclare m text[]; b text;\nbegin\n  k := coalesce(k, '');\n  if not v2 or (strpos(k, 's3_') = 0 and strpos(k, 's2_1') = 0) then return k; end if;\n  m := regexp_match(k, '^(sk:|cy:|cs:|fl:)?(s[23]_[0-9a-z]+)(:[^\\n\\r\u2028\u2029]*)?$');\n  if m is null then return k; end if;\n  b := m[2];\n  if b in ('s3_2', 's2_1') then return ''; end if;\n  if b = 's3_0' then return coalesce(m[1], '') || 's2_q0' || coalesce(m[3], ''); end if;\n  if b = 's3_1' then return coalesce(m[1], '') || 's2_q1' || coalesce(m[3], ''); end if;\n  if b = 's3_3' then return coalesce(m[1], '') || 's2_d3' || coalesce(m[3], ''); end if;\n  return k;\nend $f$;\n\n-- checkSet_(checks, k, on, keepStepSkip)\ncreate or replace function rb_pg_ckset(c jsonb, k0 text, on_ boolean, keep boolean, v2 boolean) returns jsonb language plpgsql immutable as $f$\ndeclare k text := rb_pg_alias(v2, k0); pre text; x text;\nbegin\n  if k = '' then return c; end if;\n  if not on_ then return c - k; end if;\n  if left(k, 6) = '_skip_' then\n    pre := substr(k, 7) || '_';\n    if exists (select 1 from jsonb_each(c) e where strpos(e.key, ':') = 0 and left(e.key, 1) <> '_' and left(e.key, length(pre)) = pre and rb_pg_tru(e.value)) then return c; end if;\n    return c || jsonb_build_object(k, 1);\n  end if;\n  c := c || jsonb_build_object(k, 1);\n  if left(k, 3) = 'sk:' then return c - substr(k, 4); end if;\n  if strpos(k, ':') = 0 and left(k, 1) <> '_' then\n    c := c - ('sk:' || k);\n    if not keep then\n      for x in select q from jsonb_object_keys(c) q where left(q, 6) = '_skip_' loop\n        if left(k, length(substr(x, 7)) + 1) = substr(x, 7) || '_' then c := c - x; end if;\n      end loop;\n    end if;\n  end if;\n  return c;\nend $f$;\n\ncreate or replace function rb_pg_dec(c jsonb, key text) returns text language sql immutable as $f$\n  select case when c->('cy:' || key) = '\"Y\"'::jsonb then 'Y' when c->('cy:' || key) = '\"N\"'::jsonb then 'N' else '' end $f$;\n\n-- itemRequired_\ncreate or replace function rb_pg_req(it jsonb, c jsonb, key text) returns boolean language plpgsql immutable as $f$\ndeclare d text;\nbegin\n  if jsonb_typeof(it) = 'object' and rb_pg_tru(it->'chg') then\n    d := rb_pg_dec(c, key);\n    if d = 'Y' then return true; end if;\n    if d = 'N' then return false; end if;\n  end if;\n  return not (jsonb_typeof(it) = 'object' and rb_pg_tru(it->'o'));\nend $f$;\n\n-- itemResolved_\ncreate or replace function rb_pg_res(it jsonb, c jsonb, key text) returns boolean language sql immutable as $f$\n  select rb_pg_tru(c->key) or (not rb_pg_req(it, c, key) and (\n    (jsonb_typeof(it) = 'object' and rb_pg_tru(it->'chg') and rb_pg_dec(c, key) = 'N') or rb_pg_tru(c->('sk:' || key)))) $f$;\n\n-- stepCatChecks_\ncreate or replace function rb_pg_cat(c jsonb) returns text language sql immutable as $f$\n  select case when rb_pg_tru(c->'_cg:완제품') then '완제품' when rb_pg_tru(c->'_cg:부자재') then '부자재' when rb_pg_tru(c->'_cg:임가공') then '임가공' else '' end $f$;\n\n-- itemApplies_\ncreate or replace function rb_pg_applies(it jsonb, cat text) returns boolean language sql immutable as $f$\n  select cat = '' or it is null or jsonb_typeof(it) <> 'object' or not rb_pg_tru(it->'cats')\n      or (jsonb_typeof(it->'cats') = 'array' and (jsonb_array_length(it->'cats') = 0 or (it->'cats') @> jsonb_build_array(cat)))\n      or (jsonb_typeof(it->'cats') = 'string' and strpos(it->>'cats', cat) > 0)\n      or jsonb_typeof(it->'cats') not in ('array', 'string') $f$;\n\n-- stepDoneSrv_(checks, st, dates)\ncreate or replace function rb_pg_done(c jsonb, st jsonb, d jsonb) returns boolean language plpgsql immutable as $f$\ndeclare cat text := rb_pg_cat(c); at jsonb := d->('s:' || coalesce(st->>'id', '')); it jsonb; i int := 0; k text;\n  need int := 0; got int := 0; decided boolean := false; items jsonb := case when jsonb_typeof(st->'items') = 'array' then st->'items' else '[]'::jsonb end;\nbegin\n  if rb_pg_tru(c->('_skip_' || coalesce(st->>'id', ''))) then return true; end if;\n  if not (rb_pg_tru(at) and coalesce(rb_pg_str(at), at::text) < '2026-09-30 13:00:00' collate \"C\") then\n    if jsonb_array_length(items) = 0 then return false; end if;\n    for it in select v from jsonb_array_elements(items) v loop\n      k := rb_pg_ikey(st, i); i := i + 1;\n      if rb_pg_applies(it, cat) and not rb_pg_res(it, c, k) then return false; end if;\n    end loop;\n    return true;\n  end if;\n  for it in select v from jsonb_array_elements(items) v loop\n    k := rb_pg_ikey(st, i); i := i + 1;\n    if not rb_pg_applies(it, cat) then continue; end if;\n    if jsonb_typeof(it) = 'object' and rb_pg_tru(it->'chg') and rb_pg_dec(c, k) = 'N' then decided := true; end if;\n    if rb_pg_req(it, c, k) then need := need + 1; if rb_pg_tru(c->k) then got := got + 1; end if; end if;\n  end loop;\n  return case when need > 0 then got = need else decided end;\nend $f$;\n\n-- stampSteps_ — 돌려줌 { c, d, n }\ncreate or replace function rb_pg_stamp(c jsonb, d jsonb, steps jsonb, nows text) returns jsonb language plpgsql immutable as $f$\ndeclare st jsonb; k text; dn boolean; n int := 0;\nbegin\n  for st in select v from jsonb_array_elements(coalesce(steps, '[]'::jsonb)) v loop\n    k := 's:' || coalesce(st->>'id', '');\n    dn := rb_pg_done(c, st, d);\n    if dn and rb_pg_tru(c->('_hold_' || coalesce(st->>'id', ''))) then c := c - ('_hold_' || coalesce(st->>'id', '')); end if;\n    if dn and not rb_pg_tru(d->k) then d := d || jsonb_build_object(k, nows); n := n + 1;\n    elsif not dn and rb_pg_tru(d->k) then d := d - k; n := n + 1;\n    end if;\n  end loop;\n  return jsonb_build_object('c', c, 'd', d, 'n', n);\nend $f$;\n\n-- findItemByKey_ — { st, it, i } | null\ncreate or replace function rb_pg_find_item(steps jsonb, key text) returns jsonb language plpgsql immutable as $f$\ndeclare st jsonb; i int;\nbegin\n  for st in select v from jsonb_array_elements(coalesce(steps, '[]'::jsonb)) v loop\n    for i in 0 .. coalesce(jsonb_array_length(case when jsonb_typeof(st->'items') = 'array' then st->'items' end), 0) - 1 loop\n      if rb_pg_ikey(st, i) = key then return jsonb_build_object('st', st, 'it', st->'items'->i, 'i', i); end if;\n    end loop;\n  end loop;\n  return null;\nend $f$;\n\ncreate or replace function rb_pg_kst(ms bigint, fmt text) returns text language sql immutable as $f$\n  select to_char(to_timestamp(ms / 1000.0) at time zone 'Asia/Seoul', fmt) $f$;\n\n-- 장부 한 줄 적용(applyOp_ 의 상태 부분 — 이력은 서버 _pgPost 가 같은 applyOp_ 로). st = { checks, notes, dates, ownerSet }\n-- op = { kind, at(ms), who, ch: [[열쇠, 참거짓]…](checks · 순서대로) | stepId,text(note) | stepId,idx,patch(change) | field,value(date) }\n-- cm = pgConf 의 그 모드 { steps, slots{field:[{key}]}, v2 }\ncreate or replace function rb_pg_apply(cm jsonb, st jsonb, op jsonb) returns jsonb language plpgsql immutable as $f$\ndeclare\n  c jsonb := coalesce(st->'checks', '{}'::jsonb); nt jsonb := coalesce(st->'notes', '{}'::jsonb); d jsonb := coalesce(st->'dates', '{}'::jsonb);\n  steps jsonb := coalesce(cm->'steps', '[]'::jsonb); v2 boolean := coalesce((cm->>'v2')::boolean, false);\n  ms bigint := (op->>'at')::bigint; nows text := rb_pg_kst((op->>'at')::bigint, 'YYYY-MM-DD HH24:MI:SS');\n  kind text := op->>'kind'; x jsonb; k text; on_ boolean; f jsonb; s jsonb; sst jsonb; it jsonb; key text; p jsonb; t text; m text;\n  fld text; v text; had boolean; onn boolean; n int; who0 text := split_part(coalesce(op->>'who', ''), '@', 1); r jsonb; stamp boolean := false;\nbegin\n  if kind = 'checks' then\n    for x in select v0 from jsonb_array_elements(op->'ch') v0 loop\n      c := rb_pg_ckset(c, x->>0, (x->1)::text = 'true', false, v2);\n    end loop;\n    -- checkDayStamp_(st, changes, steps, at, who)\n    for x in select v0 from jsonb_array_elements(op->'ch') v0 loop\n      k := x->>0; on_ := (x->1)::text = 'true';\n      if strpos(k, ':') > 0 or left(k, 1) = '_' then continue; end if;\n      f := rb_pg_find_item(steps, k);\n      if f is null then continue; end if;\n      if on_ and rb_pg_tru(c->k) then\n        if not rb_pg_tru(d->('ct:' || k)) then d := d || jsonb_build_object('ct:' || k, rb_pg_kst(ms, 'YYYY-MM-DD HH24:MI'), 'cw:' || k, who0); end if;\n      elsif not on_ then d := d - ('ct:' || k) - ('cw:' || k);\n      end if;\n      if jsonb_typeof(f->'it') = 'object' and (f->'it') ? 'd' then continue; end if;\n      if on_ and rb_pg_tru(c->k) then\n        if not rb_pg_tru(d->('c:' || k)) then d := d || jsonb_build_object('c:' || k, rb_pg_kst(ms, 'YYYY-MM-DD')); end if;\n      elsif not on_ then d := d - ('c:' || k);\n      end if;\n    end loop;\n    stamp := true;\n  elsif kind = 'note' then\n    if coalesce(op->>'text', '') <> '' then nt := nt || jsonb_build_object(op->>'stepId', op->>'text'); else nt := nt - (op->>'stepId'); end if;\n  elsif kind = 'change' then\n    select v0 into sst from jsonb_array_elements(steps) v0 where v0->>'id' = op->>'stepId' limit 1;\n    it := case when sst is not null then sst->'items'->((op->>'idx')::int) end;\n    if sst is not null and rb_pg_tru(it) then\n      key := rb_pg_ikey(sst, (op->>'idx')::int); p := coalesce(op->'patch', '{}'::jsonb);\n      if p ? 'dec' then\n        if p->'dec' in ('\"Y\"'::jsonb, '\"N\"'::jsonb) then c := c || jsonb_build_object('cy:' || key, p->'dec'); else c := c - ('cy:' || key); end if;\n        if p->'dec' is distinct from '\"Y\"'::jsonb then c := c - ('cs:' || key); nt := nt - ('c:' || key); end if;\n      end if;\n      if p ? 'types' then\n        select string_agg(q, ', ' order by o) into t from (\n          select rb_pg_trim(rb_pg_str(e)) as q, o from jsonb_array_elements(case when jsonb_typeof(p->'types') = 'array' then p->'types' else '[]'::jsonb end) with ordinality as z(e, o)) w where q <> '';\n        if coalesce(t, '') <> '' then c := c || jsonb_build_object('cs:' || key, t); else c := c - ('cs:' || key); end if;\n      end if;\n      if p ? 'memo' then\n        m := case when rb_pg_tru(p->'memo') then left(rb_pg_str(p->'memo'), 1000) else '' end;\n        if rb_pg_trim(m) <> '' then nt := nt || jsonb_build_object('c:' || key, m); else nt := nt - ('c:' || key); end if;\n      end if;\n      stamp := true;\n    end if;\n  elsif kind = 'date' then\n    fld := op->>'field'; v := rb_pg_trim(coalesce(op->>'value', ''));\n    had := rb_pg_tru(d->fld);\n    if v <> '' then d := d || jsonb_build_object(fld, left(v, 10)); else d := d - fld; end if;\n    onn := case when v <> '' then true when had then false else null end;\n    if fld !~ '^(req|dv):' and fld <> 'need' and onn is not null then\n      n := 0;\n      for s in select v0 from jsonb_array_elements(coalesce(cm->'slots'->fld, '[]'::jsonb)) v0 loop\n        key := s->>'key';\n        if onn = false then\n          if rb_pg_tru(c->key) then c := c - key; n := n + 1; end if;\n        elsif not rb_pg_tru(c->key) then c := rb_pg_ckset(c, key, true, true, v2); n := n + 1;\n        end if;\n      end loop;\n      if n > 0 then stamp := true; end if;\n    end if;\n  else\n    raise exception 'RB_FALLBACK 모르는 진행 기록 종류 %', kind;\n  end if;\n  if stamp then\n    r := rb_pg_stamp(c, d, steps, nows); c := r->'c'; d := r->'d';\n  end if;\n  return jsonb_build_object('checks', c, 'notes', nt, 'dates', d, 'ownerSet', coalesce(st->>'ownerSet', ''));\nend $f$;\n\n-- 순서가 중요한 체크 묶음인지(같은 항목의 체크 + [생략] · 단계 건너뛰기 + 그 단계 항목 · 옛/새 열쇠가 같은 칸)\ncreate or replace function rb_pg_order_matters(ch jsonb, v2 boolean) returns boolean language plpgsql immutable as $f$\ndeclare ks text[]; k text; a text[] := '{}'; b text;\nbegin\n  select coalesce(array_agg(x->>0), '{}') into ks from jsonb_array_elements(ch) x;\n  foreach k in array ks loop\n    b := rb_pg_alias(v2, k);\n    if b <> '' and b = any(a) then return true; end if;\n    a := a || b;\n  end loop;\n  foreach k in array a loop\n    if k = '' then continue; end if;\n    if left(k, 3) = 'sk:' and substr(k, 4) = any(a) then return true; end if;\n    if left(k, 6) = '_skip_' and exists (select 1 from unnest(a) y where strpos(y, ':') = 0 and left(y, 1) <> '_' and left(y, length(substr(k, 7)) + 1) = substr(k, 7) || '_') then return true; end if;\n  end loop;\n  return false;\nend $f$;\n\n-- 그 건(진행 기록)에 아직 반영 안 된 앞선 저장 — 할 일(pj · 자기 뒷정리 _pgPost · 진행상태 뒷정리 제외) · 진행 장부(rb_conf 'pgJ')\ncreate or replace function rb_pg_busy(p_mode text, p_id text) returns void language plpgsql security definer set search_path = public as $f$\ndeclare j record; core text := case when p_mode = 'sample' and left(p_id, 2) = 'p:' then substr(p_id, 3) else p_id end;\nbegin\n  if core = '' then return; end if;\n  select id, job->>'fn' as fn into j from rb_tab_job\n   where tab = 'pj' and done_at is null and coalesce(job->>'who', '') <> 'selftest@rb.local'\n     and coalesce(job->>'fn', '') <> '_pgPost'\n     and not (coalesce(job->>'fn', '') = '_pdPost' and coalesce(job->'args'->0->>'kind', '') = 'state')\n     and strpos(job::text, core) > 0\n   order by id limit 1;\n  if found then raise exception 'RB_FALLBACK 앞선 저장 반영 전(pj #% %)', j.id, coalesce(j.fn, ''); end if;\n  if exists (select 1 from rb_conf c where c.k = 'pgJ' and jsonb_typeof(c.v->'ids') = 'object' and (c.v->'ids') ? (p_mode || ':' || p_id)) then\n    raise exception 'RB_FALLBACK 앞선 저장 반영 전(진행 장부)';\n  end if;\nend $f$;\n\n-- m081 rb_pd_busy 다시: 진행 기록 직접 저장의 뒷정리(_pgPost)도 막지 않음(그 안에 발주 실행판ID 가 들어 있어 날짜 → 진행상태가 다음 저장마다 할 일 길로 갔다)\ncreate or replace function rb_pd_busy(p_id text) returns void language plpgsql security definer set search_path = public as $f$\ndeclare j record;\nbegin\n  if p_id = '' then return; end if;\n  select id, tab, job->>'fn' as fn into j from rb_tab_job\n   where tab in ('pj', 'od', 'ln') and done_at is null and coalesce(job->>'fn', '') not in ('_pdPost', '_pgPost')\n     and coalesce(job->>'who', '') <> 'selftest@rb.local' and strpos(job::text, p_id) > 0\n   order by id limit 1;\n  if found then raise exception 'RB_FALLBACK 앞선 저장 반영 전(% #% %)', j.tab, j.id, coalesce(j.fn, ''); end if;\n  if exists (select 1 from rb_conf c where c.k = 'pdJ' and jsonb_typeof(c.v->'ids') = 'object' and (c.v->'ids') ? p_id) then\n    raise exception 'RB_FALLBACK 앞선 저장 반영 전(진행 장부 상태 올리기)';\n  end if;\nend $f$;\n\ncreate or replace function rb_pg_ms() returns bigint language sql stable as $f$\n  select coalesce(nullif(current_setting('rb.test_ms', true), '')::bigint, (extract(epoch from clock_timestamp()) * 1000)::bigint) $f$;\n\ncreate or replace function rb_pg_iso(ms bigint) returns text language sql immutable as $f$\n  select to_char(to_timestamp(ms / 1000.0) at time zone 'UTC', 'YYYY-MM-DD\"T\"HH24:MI:SS.MS\"Z\"') $f$;\n\n-- meta 칸 값(progRowValues_: meta.x || '') — 글자 · 숫자 그대로, 빈 값은 null(시트 빈칸)\ncreate or replace function rb_pg_mcell(v jsonb) returns jsonb language plpgsql immutable as $f$\nbegin\n  if not rb_pg_tru(v) then return 'null'::jsonb; end if;\n  if jsonb_typeof(v) in ('string', 'number') then return v; end if;\n  raise exception 'RB_FALLBACK 건 정보 칸 모양(%)', jsonb_typeof(v);\nend $f$;\n\n-- ---------- 본체 ----------\n-- p_fn/p_args = 예전 api 이름 · 인자 그대로. p_keys = apiSetChecks 체크 열쇠의 화면 순서(jsonb 객체는 순서를 잃는다)\ncreate or replace function rb_pg_save_do(e text, p_fn text, a jsonb, p_keys jsonb) returns jsonb language plpgsql security definer set search_path = public as $f$\ndeclare\n  HEAD constant text[] := array['건ID', '품의번호', '품목명', '발주차수', '브랜드', '담당자', '진행JSON', '메모JSON', '최종수정', '최종수정자', '날짜JSON'];\n  ms bigint := rb_pg_ms(); conf jsonb; cm jsonb; raw_mode jsonb; m text; id text; meta jsonb; op jsonb;\n  ch jsonb := '[]'::jsonb; seen jsonb := '{}'::jsonb; chg jsonb; k text; k2 text; kk jsonb; n int; ord jsonb; v2 boolean;\n  st0 jsonb; st1 jsonb; rw int; cx jsonb; hc jsonb; i int; out jsonb; isnew boolean := false;\n  sst jsonb; it jsonb; idx int; fld text; v text; bump text := ''; down boolean := false; g jsonb; sub text; bkey text; doneb boolean;\n  pdc jsonb; mid text; f jsonb; prow int; sc int; cur text; ci int; ti int; nto text; oc int; audits jsonb := '[]'; SO constant text[] := array['계획', '상신', '승인', '발주'];\n  txt text; sid jsonb;\nbegin\n  if jsonb_typeof(a) <> 'array' then raise exception 'RB_FALLBACK 인자 모양'; end if;\n  if p_fn = 'apiSetCheck' then      -- apiSetCheck(id, meta, itemKey, on, mode) = apiSetChecks(id, meta, {itemKey: !!on}, mode)\n    if rb_pg_str(a->2) is null then raise exception 'RB_FALLBACK 체크 열쇠 모양'; end if;\n    p_keys := jsonb_build_array(rb_pg_str(a->2));\n    a := jsonb_build_array(a->0, a->1, jsonb_build_object(rb_pg_str(a->2), rb_pg_tru(a->3)), a->4);\n    p_fn := 'apiSetChecks';\n  end if;\n  raw_mode := case p_fn when 'apiSetChecks' then a->3 when 'apiSetNote' then a->4 when 'apiSetChange' then a->5 when 'apiSetDate' then a->4 else null end;\n  if p_fn not in ('apiSetChecks', 'apiSetNote', 'apiSetChange', 'apiSetDate') then raise exception 'RB_FALLBACK % 는 서버 길', p_fn; end if;\n  if raw_mode is not null and jsonb_typeof(raw_mode) <> 'null' and not (raw_mode in ('\"po\"'::jsonb, '\"sample\"'::jsonb, '\"\"'::jsonb)) then raise exception 'RB_FALLBACK 모드 모양'; end if;\n  m := case when raw_mode = '\"sample\"'::jsonb then 'sample' else 'po' end;\n  if rb_pg_tru(a->1) and jsonb_typeof(a->1) <> 'object' then raise exception 'RB_FALLBACK 건 정보 모양'; end if;\n  meta := case when jsonb_typeof(a->1) = 'object' then a->1 else null end;\n  conf := (select c.v from rb_conf c where c.k = 'pgConf');\n  cm := conf->m; v2 := coalesce((cm->>'v2')::boolean, false);\n\n  -- ① 예전 api 의 검사(journalSave_ 전) — 같은 문구\n  if p_fn = 'apiSetChecks' then\n    chg := a->2;\n    if chg is not null and jsonb_typeof(chg) not in ('object', 'null') then raise exception 'RB_FALLBACK 체크 모양'; end if;\n    chg := coalesce(case when jsonb_typeof(chg) = 'object' then chg end, '{}'::jsonb);\n    -- 화면 순서(p_keys) — 객체의 열쇠와 똑같아야 함. 없으면 jsonb 순서(순서가 중요한 묶음이면 아래에서 RB_FALLBACK)\n    if p_keys is not null and jsonb_typeof(p_keys) = 'array' then\n      ord := p_keys;\n      if (select count(distinct x) from jsonb_array_elements_text(ord) x) <> jsonb_array_length(ord)\n         or exists (select 1 from jsonb_array_elements_text(ord) x where not chg ? x)\n         or exists (select 1 from jsonb_object_keys(chg) x where not ord ? x) then raise exception 'RB_FALLBACK 체크 순서 모양'; end if;\n    else\n      ord := coalesce((select jsonb_agg(x) from jsonb_object_keys(chg) x), '[]'::jsonb);\n    end if;\n    -- JS 객체는 정수 모양 열쇠를 앞으로(작은 수부터) 놓는다 — 그런 열쇠는 흔치 않으니 서버 길\n    if exists (select 1 from jsonb_array_elements_text(ord) x where x ~ '^(0|[1-9][0-9]{0,9})$') then raise exception 'RB_FALLBACK 숫자 열쇠'; end if;\n    n := 0;\n    for k in select x from jsonb_array_elements_text(ord) x loop\n      if k = '' or length(k) > 200 then continue; end if;      -- length: JS 는 UTF-16 길이(한글 · 영문은 같음)\n      if k ~ '[\\U00010000-\\U0010FFFF]' then raise exception 'RB_FALLBACK 열쇠 글자'; end if;\n      n := n + 1;\n    end loop;\n    if n = 0 then raise exception '저장할 체크가 없습니다.'; end if;\n    if n > 200 then raise exception '한 번에 저장할 체크가 너무 많습니다.'; end if;\n    -- ch = { (모드가 샘플이 아니면 stepKeyAlias_) 열쇠: !!값 } — 순서 = 처음 넣은 자리 · 값은 마지막\n    for k in select x from jsonb_array_elements_text(ord) x loop\n      if k = '' or length(k) > 200 then continue; end if;\n      k2 := case when m = 'sample' then k else rb_pg_alias(v2, k) end;\n      if k2 = '' then continue; end if;\n      if seen ? k2 then\n        ch := (select jsonb_agg(case when y->>0 = k2 then jsonb_build_array(k2, rb_pg_tru(chg->k)) else y end order by o) from jsonb_array_elements(ch) with ordinality z(y, o));\n      else\n        ch := ch || jsonb_build_array(jsonb_build_array(k2, rb_pg_tru(chg->k))); seen := seen || jsonb_build_object(k2, 1);\n      end if;\n    end loop;\n    if jsonb_array_length(ch) = 0 then raise exception '없앤 항목입니다 — 새로고침해 주세요(발주 단계가 바뀌었습니다).'; end if;\n  elsif p_fn = 'apiSetChange' then\n    if cm is null or cm->'steps' is null then raise exception 'RB_FALLBACK 단계 정의 없음'; end if;\n    if jsonb_typeof(a->2) = 'string' then\n      select v0 into sst from jsonb_array_elements(cm->'steps') v0 where v0->>'id' = a->>2 limit 1;\n    end if;\n    if sst is null then raise exception '단계를 찾을 수 없습니다.'; end if;\n    -- Number(itemIdx)\n    if a->3 is null then raise exception 'RB_FALLBACK 항목 번호 없음';\n    elsif jsonb_typeof(a->3) = 'null' or a->3 = '\"\"'::jsonb then idx := 0;\n    elsif jsonb_typeof(a->3) = 'number' and (a->>3) ~ '^(0|[1-9][0-9]{0,5})$' then idx := (a->>3)::int;\n    elsif jsonb_typeof(a->3) = 'string' and (a->>3) ~ '^\\s*(0|[1-9][0-9]{0,5})\\s*$' then idx := btrim(a->>3)::int;\n    else raise exception 'RB_FALLBACK 항목 번호 모양'; end if;\n    it := sst->'items'->idx;\n    if not rb_pg_tru(it) or not rb_pg_tru(it->'chg') then raise exception '변경 여부를 쓰는 항목이 아닙니다. 새로고침 후 다시 해 주세요.'; end if;\n    if a->4 is not null and jsonb_typeof(a->4) not in ('object', 'null') and rb_pg_tru(a->4) then raise exception 'RB_FALLBACK 바꿀 값 모양'; end if;\n    if jsonb_typeof(a->4) = 'object' then\n      if (a->4) ? 'types' and rb_pg_tru(a->4->'types') and (jsonb_typeof(a->4->'types') <> 'array'\n          or exists (select 1 from jsonb_array_elements(a->4->'types') te where jsonb_typeof(te) <> 'string')) then raise exception 'RB_FALLBACK 종류 모양'; end if;\n      if (a->4) ? 'memo' and rb_pg_tru(a->4->'memo') and jsonb_typeof(a->4->'memo') <> 'string' then raise exception 'RB_FALLBACK 메모 모양'; end if;\n      if (a->4) ? 'memo' and jsonb_typeof(a->4->'memo') = 'string' and (a->4->>'memo') ~ '[\\U00010000-\\U0010FFFF]' and length(a->4->>'memo') > 500 then raise exception 'RB_FALLBACK 메모 글자'; end if;\n    end if;\n  elsif p_fn = 'apiSetDate' then\n    fld := coalesce(rb_pg_str(a->2), '');\n    if a->2 is null or jsonb_typeof(a->2) <> 'string' or not (fld in ('submitted', 'approved', 'need') or fld ~ '^(req|dv):[A-Za-z0-9_-]{1,60}$') then raise exception '알 수 없는 날짜 항목입니다.'; end if;\n    if rb_pg_tru(a->3) and jsonb_typeof(a->3) <> 'string' then raise exception 'RB_FALLBACK 날짜 값 모양'; end if;\n    v := rb_pg_trim(case when rb_pg_tru(a->3) then a->>3 else '' end);\n    if v ~ '[\\U00010000-\\U0010FFFF]' then raise exception 'RB_FALLBACK 날짜 글자'; end if;\n    if v <> '' and fld = 'approved' and m = 'po' and rb_t(meta->'doc') = '' and not rb_pg_tru(meta->'ordered') then\n      raise exception '품의번호가 있어야 승인할 수 있습니다 — 먼저 상신하세요.';\n    end if;\n    if m = 'po' and v <> '' and fld in ('submitted', 'approved') then bump := case fld when 'submitted' then '상신' else '승인' end; end if;\n    if m = 'po' and v = '' and fld in ('submitted', 'approved') then down := true; end if;\n  elsif p_fn = 'apiSetNote' then\n    if rb_pg_tru(a->2) and jsonb_typeof(a->2) <> 'string' then raise exception 'RB_FALLBACK 단계 모양'; end if;\n    if rb_pg_tru(a->3) and jsonb_typeof(a->3) <> 'string' then raise exception 'RB_FALLBACK 메모 모양'; end if;\n    txt := case when rb_pg_tru(a->3) then a->>3 else '' end;\n    if txt ~ '[\\U00010000-\\U0010FFFF]' and length(txt) > 1000 then raise exception 'RB_FALLBACK 메모 글자'; end if;      -- slice(0, 2000) 은 UTF-16 길이\n  end if;\n\n  -- ② journalSave_: 건ID\n  if not rb_pg_tru(a->0) then raise exception '건ID가 비어 있습니다.'; end if;\n  if jsonb_typeof(a->0) <> 'string' then raise exception 'RB_FALLBACK 건ID 모양'; end if;\n  id := a->>0;\n  if m = 'sample' and left(id, 2) = 'p:' and id !~ '^p:P[0-9A-F]{8}$' then raise exception 'RB_FALLBACK 샘플 옛 건ID'; end if;      -- sampleProgIdFix_ 는 샘플 탭을 읽는다\n\n  -- ③ 잠금 · 켜짐 · 앞선 저장\n  perform pg_advisory_xact_lock(hashtext('rb_tab_' || case m when 'sample' then 'sp' else 'pg' end));\n  conf := (select c.v from rb_conf c where c.k = 'pgConf'); cm := conf->m;      -- 잠금 뒤 다시(끄기는 같은 잠금으로 올린다)\n  if cm is null or coalesce(cm->>'on', '') <> '1' then raise exception 'RB_FALLBACK 진행 기록 직접 저장 꺼짐(%)', coalesce(cm->>'why', '설정 없음'); end if;\n  if exists (select 1 from jsonb_array_elements(cm->'steps') s0, jsonb_array_elements(case when jsonb_typeof(s0->'items') = 'array' then s0->'items' else '[]'::jsonb end) i0 where jsonb_typeof(i0) <> 'object') then\n    raise exception 'RB_FALLBACK 단계 항목 모양';\n  end if;\n  select r0.cells into hc from sheet_rows r0 where r0.tab = cm->>'tab' and r0.\"row\" = 1;\n  for i in 1 .. 11 loop\n    if rb_t(h