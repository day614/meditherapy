+/**
+ * ============================================================
+ * f497(안): 일일보고 · BOM 설정 저장 — 할 일 대기열 대신 Supabase 함수로 바로(SQL m115_cf_daily · m116_cf_bomconf) — 회사용만
+ * ------------------------------------------------------------
+ * ① 일일보고([저장] apiDailySaveRep · 병목/이슈 apiDailyIssues · 보고 제외 apiDailyHide · 저장 풀기 apiDailyUnlock)
+ *    원본 = Supabase rb_daily(날짜마다 머리 · 직접 저장한 보고서 글) · rb_dly_hide(보고 제외). 시트 '_실행판_일일보고' · 속성 rb.dlyhide.* 는 사본.
+ *    화면 rb_once → rb_dly_save 가 규칙(지난 날짜 · 다음 보고 날짜 · 이미 저장 · 잠긴 날짜 · 관리자 · 뒤 보고서 겹침 · 크기)을 보고 그 자리에서 바꾸고 진짜 결과를 준다.
+ *    서버 길(같은 api · dailyReportCore_ [저장])도 켜져 있으면 rb_dly_srv · rb_dly_write_srv 로(저장 길 하나 · 같은 잠금).
+ *    시트 맞추기: rb_tab_job tab='dly' → cfDailyDrainIn_ 가 그 날짜 줄을 '지금 rb_daily 값'으로 시트에 쓰고(차례가 바뀌어도 시트 = 원본)
+ *    뒤처리(변경이력 · 일일보고 바뀜 표시 · 미리 계산본 · 저장 풀기 기준 시각 rb.dlykeep · 머리 캐시)를 한다.
+ *    서버가 일일보고 탭 · 보고 제외를 읽기 전에는 늘 cfDailyEnsure_ 가 남은 일을 먼저 옮긴다(f351 교훈 — 서버 쪽 읽기도 원본과 같게).
+ *    켜기: cfDailyConfPublish_ 가 (꺼진 상태에서) 시트 → rb_daily 처음 채우기(rb_dly_seed) 뒤 rb_conf 'dlyConf' on. 끄기 rb.cfDaily=0(남은 일은 옮김).
+ * ② BOM 설정(반제품 차수 apiSemiPin · 자재 구분 추가 apiBomAddType · 세트 구성 빼기 apiBomSetCompOff) — rb_bom_cfset(BOM 직접 저장과 같은 켜짐 · 잠금).
+ *    속성(rb.semipin · bom:types · bom:setx)은 BomDb.js bomDbDrainIn_ 가 같은 바꾸기를 다시 해 맞춘다(cfSemiPin · cfTypeAdd · cfSetx).
+ * 자체 시험 cfDirectSelfTest_ → rb.cfDirectTest=ok → 세션 cf=1(화면 직접 저장 켜짐).
+ * ============================================================
+ */
+var RB_CFD_IN = false, RB_CFD_SEEN = false;      // SEEN: 이 실행에서 이미 남은 일을 봤다(실행마다 한 번 — 다른 사람의 직접 저장은 실행 사이에 들어온다)
+
+function cfDailyMig_() { return typeof sbMigDone_ === 'function' && sbMigDone_('m115_cf_daily'); }
+function cfBomMig_() { return typeof sbMigDone_ === 'function' && sbMigDone_('m116_cf_bomconf'); }
+/** 서버 길도 Supabase 원본으로 가는지(처음 채우고 켠 뒤) */
+function cfDailyOn_() {
+  try { return !!sbKey_() && cfDailyMig_() && str_(PropertiesService.getScriptProperties().getProperty('rb.cfDailyState')) === 'on'; } catch (e) { return false; }
+}
+
+/** 서비스 키로 함수 — 오류는 SQL 문구 그대로(사람이 보는 문구) */
+function cfRpc_(fn, args) {
+  var k = sbKey_(); if (!k) throw new Error('Supabase 키가 없습니다.');
+  var res = UrlFetchApp.fetch(sbUrl_() + '/rest/v1/rpc/' + fn, { method: 'post', contentType: 'application/json', headers: { apikey: k, Authorization: 'Bearer ' + k }, payload: JSON.stringify(args || {}), muteHttpExceptions: true });
+  var code = res.getResponseCode(), txt = String(res.getContentText() || '');
+  if (code < 200 || code >= 300) {
+    var m = txt; try { m = (JSON.parse(txt) || {}).message || txt; } catch (eJ) { m = txt; }
+    throw new Error(String(m || ('Supabase 오류 ' + code)).slice(0, 400));
+  }
+  return txt ? JSON.parse(txt) : null;
+}
+
+/** 서버 길 api(켜져 있을 때) — 같은 SQL 규칙으로 저장하고 시트를 바로 맞춘다 */
+function cfDailySrv_(fn, args, admin) {
+  var r = cfRpc_('rb_dly_srv', { p_email: me_(), p_fn: fn, p_args: args, p_admin: !!admin });
+  try { cfDailyDrainIn_(); } catch (eD) { /* 1분 작업이 */ }
+  if (r && typeof r === 'object' && !Array.isArray(r)) delete r.direct;
+  return r;
+}
+/** dailyWrite_ 대신(켜져 있을 때) — chk: 'rep'(보고서 · 이미 저장 막기) · 'lock'(특이사항 · 잠긴 날짜 막기) */
+function cfDailyWrite_(date, rep, issues, who) {
+  var js = rep ? JSON.stringify(rep) : null;
+  cfRpc_('rb_dly_write_srv', { p_email: me_(), p_date: date, p_rep: js, p_issues: rep ? null : (issues || []), p_who: who || '', p_chk: rep ? 'rep' : 'lock' });
+  cfDailyDrainIn_();
+}
+
+/** 서버가 일일보고 탭 · 보고 제외를 읽기 전에 — 남은 직접 저장을 시트 · 속성에 먼저 */
+function cfDailyEnsure_() {
+  if (RB_CFD_IN || RB_CFD_SEEN || !cfDailyOn_()) return;
+  try { cfDailyDrainIn_(); RB_CFD_SEEN = true; } catch (e) { /* 읽기는 시트 그대로 — 1분 작업이 다시 */ }
+}
+
+/**
+ * 시트 맞추기 + 뒤처리. 반환: 옮긴 일 수. 잠금은 쥔 채(이 실행이 이미 잡았으면) 또는 여기서 잡는다
+ * 일마다 done_at 을 먼저 찍어 가져가고, 실패하면 되돌린다(다음에 다시).
+ */
+function cfDailyDrainIn_() {
+  if (RB_CFD_IN || !sbKey_() || !cfDailyMig_()) return 0;
+  var cc = CacheService.getScriptCache();
