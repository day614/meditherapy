nb_array_elements(chg) with ordinality q(y, ordn) where y->>'kind' is distinct from 'add';\n  ordered := adds || edits;\n  select coalesce(max(sheet_row), 2) into maxSr from bom_rows;\n  select coalesce(max(substring(id from '^B(\\d+)$')::bigint), 0) into maxB from bom_rows;\n  W := (select coalesce(jsonb_object_agg(key, jsonb_build_object('r', value, 'f', OF->key)), '{}'::jsonb) from jsonb_each(O));\n  if isNew then W := W || jsonb_build_object(tmplId, jsonb_build_object('r', tmplRec, 'f', tmplF)); end if;\n  if rb_t(meta->'orderId') <> '' then orderRef := btrim(rb_t(meta->'doc') || ' ' || rb_t(meta->'name')) || ' [' || rb_t(meta->'orderId') || ']'; end if;\n\n  for c in select y from jsonb_array_elements(ordered) y loop\n    why := left(rb_t(c->'why'), 200);\n    if c->>'kind' = 'add' then\n      -- ── 자재 추가 ──\n      if conf->'types' is null then raise exception 'RB_FALLBACK 구분 약호 표 모름'; end if;\n      if conf->'hf' is null then raise exception 'RB_FALLBACK 핸들링피 설정 모름'; end if;\n      -- 제조사(hfMakerOf_) 핸들링피가 있으면 새 줄 배송비 수식(hfApplyRows_) — 서버 길\n      select v2 into wv from (\n        select rb_t(y->'vendor') as v2, (rb_t(y->'end_round') = '') as op_, coalesce(rb_bom_rnum(rb_t(y->'start_round')), 0) as s_, ordn\n        from jsonb_array_elements(prow) with ordinality q(y, ordn) where rb_code_key(rb_t(y->'code')) = P) z\n        order by op_ desc, s_ desc, ordn desc limit 1;\n      tcode := coalesce(conf->'types'->>rb_t(c->'type'), 'MS');\n      wv := rb_code_key(rb_t(c->'want'));\n      -- m051: 제품 · 세트 줄(세트 구성 완제품이면 그 코드) · 반제품 BOM 머리 줄(코드 = 이 품목) · 반제품(브랜드 + X + 번호 + 국가)\n      isProd := rb_t(c->'type') in ('제품', '세트'); compCode := case when isProd then wv else '' end; isComp := false;\n      if compCode <> '' and compCode <> P then\n        if compCode !~ '^[A-Z]\\d{4}[A-Z]{2}\\d+$' then raise exception '세트 구성 완제품 코드 형식이 아닙니다: % (예: H0007AA1)', compCode; end if;\n        ncode := compCode; ver := 1; tcode := ''; isComp := true;\n      elsif isProd or wv = P th