e(rb_t(gate->'at'), '') !~ '^\\d{4}-' or (gate->>'at')::timestamptz < now() - interval '15 minutes' then raise exception 'RB_FALLBACK BOM 직접 저장 표시가 오래됨'; end if;\n  if rb_t(gate->'dirty') <> '' then raise exception 'RB_FALLBACK 시트가 Supabase 보다 앞섬'; end if;\n  select rc.v into conf from rb_conf rc where rc.k = 'bomConf';\n  head := conf->'head';\n  if head is null or rb_bom_hidx(head, 'id') is null or rb_bom_hidx(head, 'cost') is null then raise exception 'RB_FALLBACK BOM 머리글 모름'; end if;\n  -- ── 옮기지 않은 경우 → 서버 길 ──\n  if jsonb_typeof(meta->'follow') = 'object' and rb_num(meta->'follow'->'statusRow') >= 2 then raise exception 'RB_FALLBACK 발주 건 맞추기(follow)'; end if;\n\n  perform pg_advisory_xact_lock(hashtext('rb_bom'));\n  -- 서버(GAS 가상 저장)가 읽고 올리는 사이면 그 저장이 끝날 때까지 서버 길로(서버 길은 스크립트 잠금에서 차례를 기다림) — m030 rb_bom_lease\n  if exists (select 1 from rb_conf rc where rc.k = 'bomLease' and coalesce(rb_t(rc.v->'until'), '') ~ '^\\d{4}-' and (rc.v->>'until')::timestamptz > now()) then raise exception 'RB_FALLBACK BOM 서버 저장 중'; end if;\n  -- ── 같은 요청 두 번(응답만 잃은 경우 — 잠금 안에서 봐야 동시에 두 번 온 것도 막음) ──\n  if op <> '' then\n    select rv into hit from rb_recent where rk = 'op:bom:' || op and rat > now() - interval '30 minutes';\n    if hit is not null then return hit::jsonb || '{\"duplicate\":true}'::jsonb; end if;\n  end if;\n\n  -- ── 그 품목 줄(Supabase 가 원본) ──\n  select coalesce(jsonb_agg(to_jsonb(b) order by b.sheet_row, b.id), '[]'::jsonb) into prow from bom_rows b where upper(b.product) = P;\n  if jsonb_array_length(prow) = 0 then\n    if jsonb_typeof(meta->'newProduct') is distinct from 'object' then raise exception 'BOM 탭에 % 줄이 없습니다.', P; end if;\n    isNew := true;                                   -- m048: 신제품 BOM\n  elsif jsonb_typeof(meta->'newProduct') = 'object' then\n    -- 앞에서 누른 저장이 이미 들어감(bomNewSame_) — 아무것도 쓰지 않고 저장된 BOM 을 돌려준다(already)\n    if rb_bom_newsame(prow, chg) then\n      return jsonb_build_object('ok', true, 'sb', 1, 'code', P, 'already', 1, 'made', '[]'::jso