@@ -386,7 +386,12 @@
  * 트리거: 1분마다 — 장부(진행 기록 · 이력)를 시트로 옮긴다(장부가 비었으면 잠금도 잡지 않는다).
  * 캐시 채우기(첫 화면 · BOM · 재고)는 10분 트리거 warmCaches 로 나눴다 — 1분마다 하면 실행 시간 한도를 많이 먹었다.
  */
+/* f484: 1분 작업이 60초를 넘기면 다음 1분 작업이 겹쳐 돌아 잠금을 서로 기다렸다. 앞 실행이 아직 돌면 이번 1분은 건너뛴다(표시는 4분 뒤 저절로 사라짐). */
 function journalDrain(e) {
+  var cJd = null; try { cJd = CacheService.getScriptCache(); if (cJd.get('jd:busy')) return; cJd.put('jd:busy', new Date().toISOString().slice(11, 19), 240); } catch (eB) { cJd = null; }
+  try { return journalDrainRun_(e); } finally { try { if (cJd) cJd.remove('jd:busy'); } catch (eR) { /* 넘어간다 */ } }
+}
+function journalDrainRun_(e) {
   RB_IS_BG = true;
   requireTriggerOrAdmin_(e, RB_J_TRIGGER);
   try { if (typeof pjDbSelfTest_ === 'function') pjDbSelfTest_(); } catch (ePt) { /* 다음 1분에 */ }      // f338 진행 기록 직접
@@ -422,7 +427,7 @@
   }
   if (keys.length) {
     var lock = LockService.getScriptLock();
-    if (lock.tryLock(60000)) { lockWhoMark_('journalDrain');
+    if (!userWaiting_() && lock.tryLock(60000)) { lockWhoMark_('journalDrain');      // f484: 기다리는 저장이 있으면 다음 1분에
       var t0 = Date.now(), n = 0;
       try { n = drainJournal_(); } finally { lock.releaseLock(); }
       try { console.log('journalDrain ' + n + '줄 ' + (Date.now() - t0) + 'ms'); } catch (e2) { /* 넘어간다 */ }
